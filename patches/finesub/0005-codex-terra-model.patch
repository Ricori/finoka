 local-codex-gpt-5_6-luna|LOCAL_CODEX|local_agent|||GPT-5.6 Luna via Codex|gpt-5.6-luna|194000|65536|false|false|true|xhigh,high,medium|1.0|-1|-1|-1|-1|false|70|false|
+local-codex-gpt-5_6-terra|LOCAL_CODEX|local_agent|||GPT-5.6 Terra via Codex|gpt-5.6-terra|194000|65536|false|false|true|xhigh,high,medium|1.0|-1|-1|-1|-1|false|80|false|
 local-codex-gpt-5_6-sol|LOCAL_CODEX|local_agent|||GPT-5.6 Sol via Codex|gpt-5.6-sol|194000|65536|false|false|true|high,high,low|1.0|-1|-1|-1|-1|false|90|false|
 local-claude-opus-5|LOCAL_CLAUDE|local_agent|||Opus 5 via Claude Code|claude-opus-5|1000000|65536|false|false|true|xhigh,high,low|1.0|-1|-1|-1|-1|false|88|false|
